# ============================================================
# School Management System — .htaccess
# ============================================================

# Set database credentials here for shared hosting
# (or set them via cPanel > Software > Environment Variables)

# SetEnv DB_HOST     localhost
# SetEnv DB_PORT     5432
# SetEnv DB_NAME     your_db_name
# SetEnv DB_USER     your_db_user
# SetEnv DB_PASS     your_db_password

# ── Security ──────────────────────────────────────────────────
# Block direct access to config and db folders
<FilesMatch "\.(sql|env|log)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to config folder directly
    RewriteRule ^config/ - [F,L]
    RewriteRule ^db/     - [F,L]
</IfModule>

# ── PHP Settings ──────────────────────────────────────────────
<IfModule mod_php.c>
    php_flag display_errors Off
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
</IfModule>
